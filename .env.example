# Copy to .env.local for local development. On Vercel, set these in the
# project's Environment Variables.

# Neon Postgres connection string (the pooled one). Leave unset locally to use
# a file database in .data/ instead.
DATABASE_URL=

# The one password that opens the app. Use a long passphrase.
APP_PASSWORD=

# Signs the login cookie and the tokens ChatGPT uses. At least 32 characters.
# Generate one with: openssl rand -base64 48
SESSION_SECRET=

# The OAuth client you paste into ChatGPT when adding the MCP server.
# Pick any id; generate the secret with: openssl rand -base64 32
OAUTH_CLIENT_ID=mirandola-recipes-chatgpt
OAUTH_CLIENT_SECRET=

# Optional. Bearer token for POST /api/recipes. Leave unset to turn that route off.
API_TOKEN=

# Optional. Extra OAuth redirect URIs to allow, comma separated, for testing
# with a client other than ChatGPT (for example the MCP Inspector).
OAUTH_EXTRA_REDIRECT_URIS=
